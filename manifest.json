{
  "manifest_version": 3,
  "name": "SessionBox - Free multi login to any website",
  "short_name": "SessionBox",
  "version": "1.3.20",
  "description": "__MSG_PROMO_SHORT__",
  "default_locale": "en",
  "icons": {
    "16": "assets/Icon16.png",
    "48": "assets/Icon48.png",
    "128": "assets/Icon128.png"
  },
  "action": {
    "default_icon": {
      "19": "assets/Icon19.png",
      "38": "assets/Icon38.png"
    },
    "default_popup": "assets/PleaseWait.html",
    "default_title": "SessionBox"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "idle",
    "webNavigation",
    "webRequest",
    "proxy",
    "cookies",
    "storage",
    "contextMenus",
    "unlimitedStorage",
    "offscreen"
  ],
  "optional_permissions": [
    "bookmarks",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sessionbox.io/*"
      ],
      "js": [
        "website-connector.content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "virtual-session.content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "updater.content-script.js",
        "overlay.content-script.js",
        "incognito.content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/VirtualSessionHelper.js",
        "assets/C6Fix.js",
        "assets/Icons/box.svg",
        "views.html",
        "view.css",
        "views.js",
        "Views/NewSessionTutorial.css",
        "assets/actions/*",
        "assets/Fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      }
    },
    "bulk_temporary_session": {
      "description": "__MSG_OPEN_BULK_TEMPORARY__",
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      }
    },
    "new_session": {
      "description": "__MSG_NEW_SESSION_COMMAND__",
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      }
    },
    "new_temporary_session": {
      "description": "__MSG_NEW_TEMPORARY_SESSION_COMMAND__",
      "suggested_key": {
        "default": "Ctrl+Shift+A"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
